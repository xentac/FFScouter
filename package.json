{
  "name": "ff-scouter-v2",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "build:safe": "tsc && vite build",
    "build:dev:watch": "bun run scripts/watch.ts",
    "serve:dist": "serve dist -l 5174 --cors",
    "dev:tm": "concurrently -k -r \"bun:build:dev:watch\" \"bun:serve:dist\"",
    "biome": "biome check --write",
    "biome:unsafe": "biome check --write --unsafe",
    "lint": "biome check && tsc --noEmit && react-doctor --no-score --blocking error",
    "react-doctor": "react-doctor --no-score --verbose",
    "test": "bun --bun vitest",
    "coverage": "vitest run --coverage",
    "release": "bun run scripts/release.ts"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "parse-duration": "^2.1.11",
    "tornapi-typescript": "^6.15.9",
    "vite": "^8.3.7",
    "vite-plugin-monkey": "^8.1.1",
    "vite-plugin-version-mark": "^0.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/jquery": "4.0.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/tampermonkey": "^5.5.0",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-doctor": "^0.9.22",
    "react-dom": "^19.3.1",
    "serve": "^14.2.7",
    "vitest": "^5.1.0",
    "vitest-indexeddb": "^0.0.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "fake-indexeddb": "4.0.2"
  }
}
